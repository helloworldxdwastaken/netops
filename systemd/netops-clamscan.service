# Installed to /etc/systemd/system/ by security_setup.sh.
[Unit]
Description=ClamAV sweep of recent files for the netops board
After=network-online.target

[Service]
Type=oneshot
User=tokyo
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=4h
ExecStart=/usr/bin/python3 /home/tokyo/netops/security_scan.py
